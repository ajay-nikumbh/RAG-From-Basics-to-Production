# Copy these names into the repository root .env file and fill in the values.

# Azure OpenAI connection (shared by chat and embeddings)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure OpenAI chat model deployment (answer generation)
AZURE_OPENAI_DEPLOYMENT_NAME=

# Azure OpenAI embedding model deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional: fixed USD to INR rate used to show costs in rupees (default 84.0)
USD_TO_INR=84.0

# Optional: Advanced RAG stage settings (defaults shown)
REWRITE_ENABLED=true
REWRITE_HISTORY_TURNS=3
CANDIDATE_K=10
RERANK_ENABLED=true
RERANK_THRESHOLD=6.0
RERANK_MIN_BEST_SCORE=2.0
MIN_CHUNKS=1
MAX_CHUNKS=5
COMPRESSION_ENABLED=false
